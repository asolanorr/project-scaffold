# Validated by packages/env — see packages/env/src/index.ts.
# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development

# Supabase pooled connection (port 6543, transaction mode). Used at runtime.
DATABASE_URL=postgres://postgres:postgres@localhost:6543/postgres

# Supabase direct connection (port 5432). Used by drizzle-kit for migrations.
DIRECT_URL=postgres://postgres:postgres@localhost:5432/postgres

# Better Auth signing key. Generate with: openssl rand -base64 32
# Rotating this invalidates every live session.
BETTER_AUTH_SECRET=replace-me-with-at-least-32-characters

# Public origin the app is served from. Must match the browser's origin, or
# the request-origin check rejects every sign-in. On Vercel leave it unset for
# previews (it defaults to the branch URL) and set it to the real domain in
# production.
BETTER_AUTH_URL=http://localhost:3000

# Set to true only to ship past a third-party embed the CSP blocks. Report-only
# reports violations and blocks nothing, so this is a deliberate, reviewable
# downgrade — not a local convenience.
CSP_REPORT_ONLY=false

# Transactional email (Resend). Leave the key unset locally: every message is
# printed to the server console instead, links included, which is how you
# verify a local sign-up. Required in production.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Scaffold <hello@your-verified-domain.com>

# Sign-up requires a verified email before a session is issued. Set to false
# only for a preview or demo without a mail provider. Never false in production.
REQUIRE_EMAIL_VERIFICATION=true

# Supabase project URL and service role key, used by @repo/storage to mint
# signed upload URLs for file uploads. Project Settings -> API in the
# Supabase dashboard. The service role key bypasses Row Level Security and
# must never reach the browser. Leave unset locally and in CI — uploads use
# the fake provider from @repo/storage/testing instead. Required in production.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe secret key and webhook signing secret, used by @repo/payments.
# Dashboard -> Developers -> API keys / Webhooks. The webhook secret verifies
# every event's signature before its body is trusted — never skip it. Leave
# unset locally and in CI — checkout uses the fake provider from
# @repo/payments/testing instead. Required in production.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET` when
# it calls a job route (apps/web/src/jobs/). Generate with: openssl rand -base64 32
# Required everywhere, like BETTER_AUTH_SECRET.
CRON_SECRET=replace-me-with-at-least-16-characters

# Sentry DSN. Project Settings -> Client Keys (DSN) in Sentry. Leave unset
# locally and in CI — a job failure still logs to the console; this only adds
# the alert. Required in production.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
