language js

// AGENTS.md rule 5: actions and queries select named columns, so a column added
// later does not leave the server by default. Escape hatch:
//   // biome-ignore lint/plugin: <why this row may leave whole>
or {
  `$db.returning()`,
  `$db.select()`
} as $call where {
  register_diagnostic(span=$call, message="arch/no-unscoped-select: name the columns (.returning({ id: t.id }) / .select({ ... })). A whole row leaves the server with every column added later.", severity="error")
}
