language js

// AGENTS.md rule 16: auth.api.* skips rate limiting and the origin check, which
// live in Better Auth's router. Mutations go through callAuthEndpoint.
`auth.api.$method` as $call where {
  register_diagnostic(span=$call, message="arch/no-auth-api: never call auth.api.* from the app. Use callAuthEndpoint, which dispatches through the HTTP handler (rate limit and origin check included).", severity="error")
}
