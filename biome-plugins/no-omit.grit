language js

// AGENTS.md rule 2: derive with .pick() (an allowlist), never .omit() (a denylist
// that makes every future column writable).
`$schema.omit($args)` where {
  register_diagnostic(span=$schema, message="arch/no-omit: derive schemas with .pick() (an allowlist), never .omit(). A denylist makes every future column writable from the request body.", severity="error")
}
