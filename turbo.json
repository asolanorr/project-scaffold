{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DIRECT_URL",
    "TEST_DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "CSP_REPORT_ONLY",
    "CI",
    "BASE_URL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "VERCEL_BRANCH_URL",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "RESEND_API_KEY",
    "EMAIL_FROM",
    "REQUIRE_EMAIL_VERIFICATION",
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "CRON_SECRET",
    "SENTRY_DSN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      // Hashed, not just passed through: the database guard reads these, so a cache
      // hit must not replay a pass from a run that pointed somewhere else.
      "env": ["DATABASE_URL", "DIRECT_URL", "TEST_DATABASE_URL"]
    },
    "db:generate": {
      "cache": false,
      "interactive": true
    },
    "db:migrate": {
      "cache": false
    },
    "db:test:setup": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    // `next typegen` (typecheck) and `next build` both write apps/docs/.next; run
    // in parallel they race on .next/types. Serialise them. The web app is not
    // listed: its typecheck is plain tsc and writes nothing under .next.
    "@repo/docs#build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "//#typecheck": {}
  }
}
